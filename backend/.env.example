NODE_ENV=development
PORT=8080
# Shell override: BACKEND_PORT=8081 npm run dev (from repository root)
APP_BASE_URL=http://localhost:3000
TIME_ZONE=Africa/Lagos
# Optional locally (a temporary random key is generated); required in production.
# Comma-separated signing keys, newest first. Generate: openssl rand -hex 48
SESSION_KEYS=
# Set 1 only behind exactly one trusted reverse proxy (including Next.js).
TRUST_PROXY_HOPS=1
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Visitors
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback
RECEPTIONIST_EMAILS=
