{
  "name": "@diaspora/backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build --workspace @diaspora/shared && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@diaspora/shared": "2.0.0",
    "cookie-session": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.1.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^4.0.8",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
